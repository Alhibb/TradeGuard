# Server-side Singapore Qwen. Paste your key below, then restart the app.
# Set QWEN_ENABLED=true when you are ready to send agreement text to Qwen.
QWEN_ENABLED=false
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Optional deployed Monad testnet contracts. Leave blank for sandbox mode.
ESCROW_ADDRESS=
TOKEN_ADDRESS=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# Keep wallet private keys out of this file. Use your browser wallet for the UI.
